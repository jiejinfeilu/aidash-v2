# ================================================================
# AiDash 环境变量示例（复制本文件为 .env 仅用于本地参考）
# 正式环境请在 Vercel 控制台 → Project → Settings → Environment Variables 里填写
# ================================================================

# AI 服务商：deepseek（默认，国内直连）/ openai / zhipu
AI_PROVIDER=deepseek

# DeepSeek（https://platform.deepseek.com 创建 API Key）
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

# 智谱 GLM（https://open.bigmodel.cn 创建 API Key；识图默认走它，免费）
ZHIPU_API_KEY=
ZHIPU_MODEL=glm-4.6v-flash

# 识图引擎：auto（推荐）/ deepseek / zhipu / openai / none；可逗号兜底如 deepseek,zhipu
VISION_PROVIDER=auto

# 手机端可选模型白名单（换行/逗号分隔 "provider:model"）
# ALLOWED_AI_MODELS=deepseek:deepseek-v4-flash,deepseek:deepseek-v4-pro,zhipu:glm-4.6v-flash,openai:gpt-4o-mini

# OpenAI（可选备选，需海外支付方式）
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# GitHub fine-grained Token（仅授权 aidash-v2 仓库 Contents + Actions 读写）
GITHUB_TOKEN=
GITHUB_REPO=jiejinfeilu/aidash-v2
GITHUB_BRANCH=main

# 手机端口令（4~6 位，前端“设置”页需填写同一个）
APP_PIN=1234
